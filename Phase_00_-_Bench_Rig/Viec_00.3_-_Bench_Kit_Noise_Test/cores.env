# ID core của máy đo (Core Ultra 9 275HX: 8 P-core + 16 E-core, không Hyper-Threading).
# Xác nhận bằng scripts/cores_check.sh.
P_CORES=0-7
E_CORES=8-23
# Core mặc định để pin benchmark: một P-core khác CPU 0 (CPU 0 hay gánh interrupt).
BENCH_CORE=2
# Một E-core để đo đối chứng P vs E.
BENCH_E_CORE=12
